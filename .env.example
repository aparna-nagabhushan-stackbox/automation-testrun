# Copy this file to .env and fill in real values. Never commit .env itself.

# Required. Signs login sessions — any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Only emails ending in this domain can be invited or self-bootstrap as the
# first admin account.
ALLOWED_DOMAIN=@stackbox.xyz

# Port the server listens on. Most hosts (Render, Railway, etc.) set this
# automatically — leave unset in production and it'll pick it up from them.
PORT=3000

# Set to "production" when deployed — makes login cookies HTTPS-only.
NODE_ENV=development

# Required for the AI Recorder's Claude-backed step/summary/test-data generation.
# Get one from https://console.anthropic.com/.
ANTHROPIC_API_KEY=
