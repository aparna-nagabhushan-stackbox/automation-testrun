<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Login Suite" thread-count="1">

    <test name="TC-001 - To verify login functionality with valid user id and valid pwd">
        <classes>
            <class name="tests.LoginTests">
                <methods>
                    <include name="TC_001_WMS_WEB_LOGIN"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="TC-002 - To verify branch switching">
        <classes>
            <class name="tests.LoginTests">
                <methods>
                    <include name="TC_002_WMS_BRANCH_SWITCH"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
